# Copy to .env (git-ignored). All values are optional; the workbench runs fully without AI.

# Where projects, uploads and app.db are stored (default: ./workspace)
BIWB_WORKSPACE=./workspace

# AI layer (not built until Phase 8). Disabled by default.
BIWB_AI_ENABLED=false
# Requested model. The Anthropic Models API is the source of truth: if this ID cannot be
# verified at runtime, AI stays disabled.
BIWB_AI_MODEL=claude-opus-5-5
BIWB_AI_EFFORT=medium
# ANTHROPIC_API_KEY=   <- set in your shell or here; never commit it
