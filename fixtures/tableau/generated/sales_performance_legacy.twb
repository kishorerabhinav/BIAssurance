      <column caption="Line Gross" datatype="real" name="[Calculation_4291057619009283450]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[QTY] * [UnitPx]"/>
      </column>
      <column caption="Discount Amount" datatype="real" name="[Calculation_2561686045575075921]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[QTY] * [UnitPx] * ZN([DiscPct])"/>
      </column>
      <column caption="Line Net" datatype="real" name="[Calculation_1376352615618972524]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[Calculation_4291057619009283450] - [Calculation_2561686045575075921]"/>
      </column>
      <column caption="Line Cost" datatype="real" name="[Calculation_1961682181052967704]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[QTY] * [UnitCost]"/>
      </column>
      <column caption="Gross Profit" datatype="real" name="[Calculation_3085436767084540471]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[Calculation_1376352615618972524] - [Calculation_1961682181052967704]"/>
      </column>
      <column caption="Net Revenue" datatype="real" name="[Calculation_1865316738016982776]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Calculation_1376352615618972524])"/>
      </column>
      <column caption="GP Margin %" datatype="real" name="[Calculation_8703596562993418453]" role="measure" type="quantitative" default-format="p0.00%">
        <calculation class="tableau" formula="SUM([Calculation_3085436767084540471]) / SUM([Calculation_1376352615618972524])"/>
      </column>
      <column caption="Orders" datatype="integer" name="[Calculation_1634371333570232122]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD([OrdID])"/>
      </column>
      <column caption="AOV" datatype="real" name="[Calculation_1901466377084404059]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Calculation_1376352615618972524]) / COUNTD([OrdID])"/>
      </column>
      <column caption="Return Rate" datatype="real" name="[Calculation_3203917264098699922]" role="measure" type="quantitative" default-format="p0.00%">
        <calculation class="tableau" formula="SUM([RtnAmt]) / SUM([Calculation_1376352615618972524])"/>
